// Cloudflare Workers static assets: serves site/public with no Worker code.
// Deploy from this folder with `npx wrangler deploy`. Headers come from
// public/_headers, generated by scripts/site.
{
  "name": "tfviz-site",
  "compatibility_date": "2026-10-10",
  // Serve only on the real domain, not on a workers.dev or preview URL.
  // Deploying creates the DNS records and certificates for both names.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tfviz.com", "custom_domain": true },
    { "pattern": "www.tfviz.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
