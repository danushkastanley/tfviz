// Cloudflare Workers static assets: serves site/public with no Worker code.
// Deploy from this folder with `npx wrangler deploy`. Headers come from
// public/_headers, generated by scripts/site.
{
  "name": "tfviz-site",
  "compatibility_date": "2026-10-10",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
