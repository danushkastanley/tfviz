<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="{{.CSP}}">
<meta name="referrer" content="no-referrer">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="tfviz">
<title>{{.Title}}</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22%3E%3Crect width=%2232%22 height=%2232%22 rx=%227%22 fill=%22%231d1d1f%22/%3E%3Cpath d=%22M9 11h14M9 16h9M9 21h11%22 stroke=%22%23f4f4f2%22 stroke-width=%222.4%22 stroke-linecap=%22round%22/%3E%3C/svg%3E">
<style>{{.Style}}</style>
</head>
<body>
<div id="root"></div>
<section id="static-summary" class="static-summary" aria-label="Report summary">
<h1>{{.Title}}</h1>
<p>{{.Summary.Mode}} · {{.Summary.Total}} resources. The interactive diagram needs JavaScript; this summary lists every change.</p>
{{- if .Summary.Counts}}
<ul>{{range .Summary.Counts}}<li>{{.Count}} {{.Label}}</li>{{end}}</ul>
{{- end}}
{{- if .Summary.Changes}}
<table>
<thead><tr><th scope="col">Change</th><th scope="col">Address</th><th scope="col">Type</th></tr></thead>
<tbody>{{range .Summary.Changes}}<tr><td>{{.Change}}</td><td><code>{{.Address}}</code></td><td>{{.Type}}</td></tr>{{end}}</tbody>
</table>
{{- end}}
</section>
<script type="application/json" id="tfviz-report">{{.Data}}</script>
{{- if .Explore}}
<script type="application/json" id="tfviz-explore">{{.Explore}}</script>
{{- end}}
<script type="module">{{.Script}}</script>
<template id="tfviz-notices"><pre>{{.Notices}}</pre></template>
</body>
</html>
